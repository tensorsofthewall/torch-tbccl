{
  "schema_version": 1,
  "repo": "tensorsofthewall/torch-tbccl",
  "scan": [
    "README.md",
    "MAINTENANCE.md",
    "RELEASE.md",
    "docs/**/*.md"
  ],
  "exclude": [
    "docs/validation/*",
    "docs/adr/*",
    "docs/project/changelog.md",
    "docs/benchmarks/results.md"
  ],
  "exclude_reason": "Validation reports, decision records, the changelog page and the benchmark results page record what was true or measured for an earlier version and must keep those versions. They are not scanned for release URLs or artifact names.",
  "versions": {
    "bundled_tbccl": "0.7.1"
  },
  "statements": [
    {
      "file": "README.md",
      "find": "^> \\*\\*Status:\\*\\* \\*\\*(?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?)\\*\\*",
      "expect": "current",
      "describe": "README status line"
    },
    {
      "file": "README.md",
      "find": "`torch_tbccl (?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?)`",
      "expect": "current",
      "describe": "README expected torch_tbccl version"
    },
    {
      "file": "README.md",
      "find": "`libtbccl (?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?)`",
      "expect": "version:bundled_tbccl",
      "describe": "README expected bundled libtbccl version"
    },
    {
      "file": "docs/index.md",
      "find": "The current release is (?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?)",
      "expect": "current",
      "describe": "documentation homepage release statement"
    },
    {
      "file": "docs/getting-started/install.md",
      "find": "The (?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?) wheels are attached",
      "expect": "current",
      "describe": "installation page release statement"
    },
    {
      "file": "docs/getting-started/install.md",
      "find": "^torch_tbccl +(?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?)",
      "expect": "current",
      "describe": "expected torch_tbccl output"
    },
    {
      "file": "docs/getting-started/install.md",
      "find": "^libtbccl +(?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?)",
      "expect": "version:bundled_tbccl",
      "describe": "expected bundled libtbccl output"
    },
    {
      "file": "docs/getting-started/quickstart.md",
      "find": "torch_tbccl=(?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?)",
      "expect": "current",
      "describe": "expected torch_tbccl in the quickstart output"
    },
    {
      "file": "docs/getting-started/quickstart.md",
      "find": "tbccl_runtime=(?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?)",
      "expect": "version:bundled_tbccl",
      "describe": "expected bundled TBCCL in the quickstart output"
    },
    {
      "file": "docs/reference/compatibility.md",
      "find": "^\\| Package version \\| (?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?) \\|",
      "expect": "current",
      "describe": "compatibility page package version"
    },
    {
      "file": "docs/reference/compatibility.md",
      "find": "contain libtbccl (?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?) statically",
      "expect": "version:bundled_tbccl",
      "describe": "compatibility page bundled libtbccl"
    },
    {
      "file": "MAINTENANCE.md",
      "find": "^torch-tbccl (?P<v>\\d+\\.\\d+\\.\\d+(?:rc\\d+)?):",
      "expect": "current",
      "describe": "MAINTENANCE supported release"
    }
  ],
  "allow": []
}
